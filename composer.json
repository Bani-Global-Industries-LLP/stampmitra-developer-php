{
    "name": "stampmitra/stampmitra-php",
    "description": "Official PHP SDK for the StampMitra Developer API: Indian identity verification (PAN, GSTIN, RC, Voter ID, DL, Passport, CIN, Udyam, bank account) and e-Stamp Paper.",
    "type": "library",
    "license": "MIT",
    "keywords": ["stampmitra", "kyc", "pan", "gstin", "estamp", "india", "verification", "sdk"],
    "homepage": "https://developer.stampmitra.in",
    "support": {
        "docs": "https://developer.stampmitra.in/docs",
        "issues": "https://github.com/Bani-Global-Industries-LLP/stampmitra-developer-php/issues",
        "source": "https://github.com/Bani-Global-Industries-LLP/stampmitra-developer-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.50",
        "guzzlehttp/guzzle": "^7.5",
        "phpstan/phpstan": "^1.11 || ^2.0",
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Recommended PSR-18 client (auto-discovered, and used for per-request timeouts)",
        "symfony/http-client": "Alternative PSR-18 client (with nyholm/psr7)"
    },
    "autoload": {
        "psr-4": {
            "StampMitra\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StampMitra\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "coverage:spec": "php scripts/check-spec-coverage.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
